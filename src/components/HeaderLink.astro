---
const { href, class: className, ...props} = Astro.props;

const { pathname } = Astro.url;

console.log(pathname, href);

const isActive = href === pathname;
---

<a href={href} class:list={[className, { active: isActive}]} {...props}>
    <slot />
</a>

<style>
    a {
        color: #ffffff;
        text-decoration: none;

        a.active {
            color: #9dff9b;
        }
    }
</style>


